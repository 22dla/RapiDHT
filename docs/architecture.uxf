    </coordinates>
    <panel_attributes>«enumeration»
*Modes*
--
CPU   — OpenMP, radix-2 fast Hartley
GPU   — CUDA, cas matrices × cuBLAS GEMM
RFFT  — real FFT, 1D only, for comparison
bg=#FFFFFF</panel_attributes>
    <additional_attributes/>
  </element>
